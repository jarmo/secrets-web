<!DOCTYPE html>
<html>
  <head>
    <title>Your vaults - Secrets</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-csrf-token" content="{{ .csrfToken }}">
    <link rel="stylesheet" href="/public/assets/css/bootstrap-reboot.min.css">
    <link rel="stylesheet" href="/public/assets/css/app.css">
    <meta name="x-session-max-age-in-seconds" content="{{ .sessionMaxAgeInSeconds }}">
    <script src="/public/assets/js/app.js"></script>
    <script src="/public/assets/js/modal.js"></script>
    <script src="/public/assets/js/auto_suggest.js"></script>
    <script src="/public/assets/js/initialize_app.js"></script>
  </head>
  <body>
    <main>
      <div class="container">
        <aside>
          <a href="/settings" class="btn">Settings</a>
          <form id="logout" action="/logout" method="post"><button class="logout btn" type="submit">× Logout</button></form>
        </aside>
        <h1>Your vaults</h1>
        {{ if .vaults }}
          <div class="filter">
            <input id="vault-filter" type="text" autocomplete="off" autofocus>
            <label for="vault-filter"><span>Filter</span></label>
          </div>
        {{ end }}
        <div id="vaults">
          {{ range .vaults }}<p class="vault"><a href="/vaults/{{ . | urlquery }}">{{ . }}</a></p>{{ else }}<p>No vaults available.</p>{{ end }}
        </div>
      </div>
    </main>
  </body>
</html>
