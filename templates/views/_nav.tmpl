<header class="site-header">
  {{ if .authPage }}
    <span class="header-spacer" aria-hidden="true"></span>
  {{ else }}
    <a href="{{ if or .user .username }}/vaults{{ else }}/{{ end }}" class="brand" aria-label="Secrets home">
      <img src="/public/assets/favicon.png" alt="" width="44" height="39"><span>ecrets</span>
    </a>
  {{ end }}
  <nav class="site-nav{{ if or .user .username }} site-nav-auth{{ end }}" aria-label="Main navigation">
    {{ if or .user .username }}
      <div class="nav-account">
        {{ if .username }}<span class="nav-username" title="Logged in as {{ .username }}">{{ .username }}</span>{{ end }}
        <div class="nav-actions">
          {{ if .showVaultsLink }}<a href="/vaults" class="nav-link">Vaults</a>{{ end }}
          <a href="/settings" class="nav-link">Settings</a>
          <form id="logout" action="/logout" method="POST"><button class="nav-button" type="submit">Log out</button></form>
        </div>
      </div>
      <span class="nav-divider" aria-hidden="true"></span>
    {{ end }}
    <button type="button" class="theme-toggle" data-theme-toggle title="Switch color theme" aria-label="Switch color theme">
      <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
      <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"/></svg>
    </button>
  </nav>
</header>
