{{ range .secrets }}
  <details class="secret panel">
    <summary class="secret-summary"><span class="secret-name">{{ .Name }}</span></summary>
    <div class="secret-content">
      <form id="secret-edit-{{ .Id }}" action="{{ $.vaultPath }}/{{ .Id }}" method="PUT">
        <div class="field">
          <label for="secret-edit-name-{{ .Id }}">Name</label>
          <input id="secret-edit-name-{{ .Id }}" type="text" value="{{ .Name }}" name="name" required autocomplete="off">
        </div>
        <div class="field">
          <label for="secret-edit-value-{{ .Id }}">Value</label>
          <textarea id="secret-edit-value-{{ .Id }}" name="value" required autocomplete="off" rows="5" wrap="off">{{ .Value }}</textarea>
        </div>
      </form>
      <div class="secret-actions">
        <button type="submit" form="secret-edit-{{ .Id }}" class="btn btn-primary">Save changes</button>
        <button type="button" class="btn btn-danger-outline" data-delete-toggle aria-expanded="false" aria-controls="delete-confirm-{{ .Id }}">Delete</button>
      </div>
      <div id="delete-confirm-{{ .Id }}" class="delete-confirm-body" hidden>
        <p>To delete this secret, type <strong>{{ .Name }}</strong> below.</p>
        <form class="delete" action="{{ $.vaultPath }}/{{ .Id }}" method="DELETE">
          <label class="sr-only" for="delete-name-{{ .Id }}">Confirm secret name</label>
          <input id="delete-name-{{ .Id }}" type="text" required autocomplete="off" spellcheck="false" data-delete-name="{{ .Name }}" aria-label="Type {{ .Name }} to confirm deletion">
          <div class="delete-buttons">
            <button type="button" class="btn" data-delete-cancel>Cancel</button>
            <button type="submit" class="btn btn-danger" disabled>Confirm delete</button>
          </div>
        </form>
      </div>
    </div>
  </details>
{{ end }}
