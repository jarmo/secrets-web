<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Activate account — Secrets</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-csrf-token" content="{{ .csrfToken }}">
    <script src="/public/assets/js/theme.js"></script>
    <link rel="stylesheet" href="/public/assets/css/bootstrap-reboot.min.css">
    <link rel="stylesheet" href="/public/assets/css/app.css">
    <link rel="icon" type="image/png" href="/public/assets/favicon.png">
    <script src="/public/assets/js/activate.js" defer></script>
  </head>
  <body>
    {{ template "/templates/views/_nav.tmpl" . }}
    <main class="auth-layout">
      <section class="panel auth-card" aria-labelledby="activation-heading">
        <div class="auth-brand"><img src="/public/assets/favicon.png" alt="" width="76" height="69"><span>ecrets</span></div>
        <h1 id="activation-heading">Activate your account</h1>
        {{ if .activated }}
          <p class="page-description">Your account is ready.</p>
          <p class="auth-footer"><a href="/">Continue to login</a></p>
        {{ else }}
          <p class="page-description">Use the setup code provided by your administrator.</p>
          {{ if .error }}<div class="toast toast-error" role="alert"><p>{{ .error }}</p></div>{{ end }}
          <form id="activate" action="/activate" method="post" autocomplete="off">
            <div class="field">
              <label for="username">Username</label>
              <input id="username" name="username" type="text" required autocomplete="off" autofocus>
            </div>
            <div class="field">
              <label for="setup-code">Setup code</label>
              <input id="setup-code" name="setupCode" type="text" required autocomplete="off" spellcheck="false">
            </div>
            <div class="field">
              <label for="password">Password</label>
              <input id="password" name="password" type="password" required minlength="12" autocomplete="new-password">
            </div>
            <div class="field">
              <label for="confirmation">Confirm password</label>
              <input id="confirmation" name="confirmation" type="password" required minlength="12" autocomplete="new-password">
            </div>
            <div class="form-actions"><button type="submit" class="btn btn-primary">Activate account</button></div>
          </form>
          <p class="auth-footer"><a href="/">Back to login</a></p>
        {{ end }}
      </section>
    </main>
  </body>
</html>
