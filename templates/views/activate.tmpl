<!DOCTYPE html>
<html>
  <head>
    <title>Activate user - Secrets</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-csrf-token" content="{{ .csrfToken }}">
    <link rel="stylesheet" href="/public/assets/css/bootstrap-reboot.min.css">
    <link rel="stylesheet" href="/public/assets/css/app.css">
    <link rel="icon" type="image/png" href="/public/assets/favicon.png">
    <script src="/public/assets/js/activate.js" defer></script>
  </head>
  <body>
    <main>
      <div class="container">
        <h1 id="title"><img src="/public/assets/favicon.png">ecrets</h1>
        {{ if .activated }}
          <p>Account activated successfully.</p>
        {{ else }}
          {{ if .error }}<p role="alert">{{ .error }}</p>{{ end }}
          <h2>Activate user account</h2>
          <form id="activate" action="/activate" method="post">
            <input id="username" name="username" type="text" required autocomplete="username" autofocus>
            <label for="username"><span>Username</span></label>
            <input id="setup-code" name="setupCode" type="text" required autocomplete="off">
            <label for="setup-code"><span>Setup code</span></label>
            <input id="password" name="password" type="password" required minlength="12" autocomplete="new-password">
            <label for="password"><span>Password</span></label>
            <input id="confirmation" name="confirmation" type="password" required minlength="12" autocomplete="new-password">
            <label for="confirmation"><span>Confirm password</span></label>
            <input type="submit" value="Activate">
          </form>
        {{ end }}
        <p><a href="/">Back to login</a></p>
      </div>
    </main>
  </body>
</html>
